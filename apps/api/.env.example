# ── PostgreSQL ──────────────────────────────────────────────────
# Connection string for Drizzle ORM.
# When absent, the API falls back to in-memory repositories (safe for dev/test).
# DATABASE_URL=postgresql://user:password@localhost:5432/rom_dev

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# ── Server ──────────────────────────────────────────────────────
PORT=4000
