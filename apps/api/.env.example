# ── PostgreSQL ──────────────────────────────────────────────────
# Connection string for Drizzle ORM.
# REQUIRED in production (NODE_ENV=production). Falls back to in-memory repos when absent.
# DATABASE_URL=postgresql://user:password@localhost:5432/physiolens_dev

# ── Auth ────────────────────────────────────────────────────────
# REQUIRED: JWT secret for signing authentication tokens.
# SECURITY: Must be a strong, random secret (minimum 32 characters).
# Generate with: openssl rand -base64 32
# In production: Use AWS Secrets Manager or HashiCorp Vault.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# ── Server ──────────────────────────────────────────────────────
PORT=4000

# ── CORS ────────────────────────────────────────────────────────
# REQUIRED in production. Comma-separated list of allowed origins.
# When absent, all origins are allowed (development mode).
# CORS_ORIGIN=https://app.physiolens.io,https://physiolens.io

# ── Stripe billing ──────────────────────────────────────────────
# Replace placeholders with real keys before enabling billing.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_ID_PRO_MONTHLY=price_placeholder
STRIPE_PRICE_ID_PRO_YEARLY=price_placeholder
STRIPE_PRICE_ID_PRACTICE_MONTHLY=price_placeholder
STRIPE_PRICE_ID_PRACTICE_YEARLY=price_placeholder

# ── Email (Resend) ──────────────────────────────────────────────
# Replace placeholder with real API key before enabling email.
RESEND_API_KEY=re_placeholder
FROM_EMAIL=hello@physiolens.io

# ── App URLs ────────────────────────────────────────────────────
APP_URL=https://app.physiolens.io
NEXT_PUBLIC_APP_URL=https://app.physiolens.io
NODE_ENV=development
