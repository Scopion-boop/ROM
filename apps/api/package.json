{
    "name": "@physiolens/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc --project tsconfig.json",
        "start": "node dist/server.js",
        "lint": "eslint src/",
        "test": "vitest run",
        "test:unit": "vitest run --exclude='**/drizzle/**'",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@physiolens/shared-types": "workspace:*",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.4",
        "drizzle-orm": "^0.45.1",
        "express": "^4.21.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "postgres": "^3.4.8",
        "resend": "^6.9.2",
        "stripe": "^20.3.1",
        "uuid": "^11.0.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "drizzle-kit": "^0.31.8",
        "supertest": "^7.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0",
        "vitest": "^3.0.0"
    }
}
