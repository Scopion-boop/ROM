# ── API Configuration ──
# In production, set to your deployed API URL (e.g., https://api.physiolens.io).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Stripe (Billing) ──
# Replace placeholder with your Stripe publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# ── AI Interpretation (server-side only) ──
# Provide at least one API key. If both are set, OpenAI is used by default.
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o          # optional override

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514  # optional override

# ── WebRTC Signaling ──
NEXT_PUBLIC_SIGNAL_PORT=4001

# ── CV Service WebSocket ──
# In production, set to your deployed CV service URL (e.g., wss://cv.physiolens.io/api/v1/capture/stream).
NEXT_PUBLIC_CV_WS_URL=ws://localhost:8000/api/v1/capture/stream
