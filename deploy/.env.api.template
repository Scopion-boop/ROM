# PhysioLens API — Production Environment Variables
# Copy to /opt/physiolens/.env.api on the server and fill in values.

# Auth
JWT_SECRET=            # Generate: openssl rand -base64 64
JWT_EXPIRES_IN=24h

# Stripe billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_PRICE_ID_PRO_YEARLY=price_...
STRIPE_PRICE_ID_PRACTICE_MONTHLY=price_...
STRIPE_PRICE_ID_PRACTICE_YEARLY=price_...

# Email (Resend)
RESEND_API_KEY=re_...
FROM_EMAIL=hello@physiolens.com

# URLs
APP_URL=https://physiolens.com
CORS_ORIGIN=https://physiolens.com
