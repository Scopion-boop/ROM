# PhysioLens Database — Production Environment Variables
# Copy to /opt/physiolens/.env on the server (used by docker-compose.prod.yml).

POSTGRES_USER=physiolens
POSTGRES_PASSWORD=     # Generate: openssl rand -base64 32
POSTGRES_DB=physiolens_prod

# Build args for Next.js (NEXT_PUBLIC_* baked at build time)
NEXT_PUBLIC_API_URL=https://api.physiolens.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_SIGNAL_URL=wss://physiolens.com/ws/signaling

# Signaling server allowed origins (set in docker-compose.prod.yml, override here if needed)
# ALLOWED_ORIGINS=https://physiolens.com,https://www.physiolens.com
